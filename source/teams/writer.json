{
  "runtime": {
    "max_turns": 600,
    "command_timeout": 600,
    "analysis_timeout": 600,
    "max_output": 200000,
    "max_file_size": 200000,
    "max_analysis_script_size": 100000,
    "max_analysis_read": 200000
  },

  "role_descriptions": {
    "analyst": "Scientific data analyst. Examines experimental and simulation data, performs quantitative analyses, identifies robust patterns, and reports evidence without overinterpretation.",
    "thinker": "Scientific conceptual strategist. Synthesizes evidence into the main ideas, arguments, interpretations, and narrative structure of the manuscript.",
    "catchy_sentencer": "Scientific phrasing specialist. Formulates important ideas clearly and memorably, and improves drafted text for precision, readability, impact, and flow without changing its scientific meaning.",
    "writer": "Scientific writer. Converts validated analyses, concepts, and narrative decisions into coherent manuscript text while preserving scientific accuracy and appropriate nuance.",
    "pub_crawler": "Scientific literature specialist. Searches the scientific literature for relevant references, verifies their relevance, and connects published evidence to specific statements in the manuscript.",
    "illustrator": "Scientific figure designer. Uses the available data, analyses, and manuscript narrative to design and generate clear, publication-quality figures that faithfully represent the evidence.",
    "reviewer": "Independent scientific reviewer. Audits analyses, reasoning, figures, references, and manuscript text for inconsistencies, unsupported claims, omissions, and other problems, and requests renewed analysis when necessary."
  },

